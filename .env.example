POSTGRES_USER=xxxx                 # имя пользователя PostgreSQL (для сервиса postgres)
POSTGRES_PASSWORD=yyyy             # пароль пользователя PostgreSQL
POSTGRES_DB=name                   # имя базы данных PostgreSQL
DB_DSN=postgres://xxxx:yyyy@postgres:5432/name?sslmode=disable  # DSN для подключения Go-сервисов к Postgres

SMTP_HOST=mail.example.com         # SMTP-сервер для отправки писем
SMTP_PORT=xx                       # порт SMTP-сервера (обычно 587/465/25)
SMTP_FROM=mail@example.com         # адрес отправителя в письмах (From)

TELEGRAM_TOKEN=xxxxx:xxxx-xxxxx    # токен Telegram-бота от @BotFather
ADMIN_CHAT_ID=xxxxxxx              # chat_id админского чата (для админ-команд бота)

TELEGRAM_API_ID=123456             # api_id из https://my.telegram.org (для локального Bot API)
TELEGRAM_API_HASH=your_api_hash_here  # api_hash из https://my.telegram.org (для локального Bot API)
TELEGRAM_API_BASE=http://telegram-bot-api:8081  # base URL локального Telegram Bot API в docker-сети

# Опционально: путь к файлу cookies (Netscape) для yt-dlp — чтобы качать Instagram под отдельным аккаунтом (см. README)
# YTDLP_COOKIES_PATH=/cookies/instagram.txt
